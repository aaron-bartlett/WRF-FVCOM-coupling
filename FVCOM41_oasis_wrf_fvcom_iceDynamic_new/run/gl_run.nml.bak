 &NML_CASE
 CASE_TITLE      = 'gl',
 TIMEZONE        = 'UTC',
 DATE_FORMAT     = 'YMD', !or 'DMY',
 START_DATE      = '1997-01-01 00:00:00',
 END_DATE        = '1997-01-01 12:00:00'
 DATE_REFERENCE  = 'default',
 /
 &NML_STARTUP
 STARTUP_TYPE    = 'hotstart',!'hotstart','coldstart','forecast','crashrestart',
 STARTUP_FILE    = 'gl_restart_20180801.nc',
 STARTUP_UV_TYPE 	 = 'set values',! 'set values'
 STARTUP_TURB_TYPE = 'set values',! 'set values'
 STARTUP_TS_TYPE = 'set values',! 'linear' 'observed','set values'
 STARTUP_T_VALS  =  2.0,
 STARTUP_S_VALS  =  0.0,
 STARTUP_U_VALS  =  0.0,
 STARTUP_V_VALS  =  0.0,
 STARTUP_DMAX    =  -10.0    
 /
 &NML_IO
