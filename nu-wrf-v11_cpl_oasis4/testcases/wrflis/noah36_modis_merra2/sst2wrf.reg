THIS=SST2WRF

cd $RUNDIR || exit 1

# Block for regression testing

if [ -z ${SBATCH_JOB_ID+x} ]; then
   echo 'Using pre-staged data'
   SST_DATA=(`ls $DATADIR/SSTRSS_201507/SSTRSS*`)
