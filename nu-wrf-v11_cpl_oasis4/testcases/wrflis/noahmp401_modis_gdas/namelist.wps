&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '2015-07-11_12:00:00','1979-11-08_00:00:00',
 end_date   = '2015-07-12_12:00:00','1979-11-08_00:00:00',
 interval_seconds = 10800,
 io_form_geogrid = 2,
 debug_level = 0,
/

&geogrid
 parent_id         =   1,   1,   2,
 parent_grid_ratio =   1,   3,   3,
 i_parent_start    =   1,  95, 152,
 j_parent_start    =   1,  38, 140,
 s_we              =   1,   1,   1,
 e_we              = 301, 430, 457, 
 s_sn              =   1,   1,   1,
 e_sn              = 241, 412, 457, 
 geog_data_res     = 'modis_30s+30s',
 dx        = 4000, 
 dy        = 4000, 
 map_proj  = 'lambert',
 ref_lat   =  38.,
 ref_lon   = -99.4,
 truelat1  =  40.,
 truelat2  =  34.,
 stand_lon = -99.4,
 geog_data_path = '/discover/nobackup/projects/nu-wrf/cases/geog'
/

&ungrib
 out_format = 'WPS',
 prefix     = 'NARR',
/

&metgrid
