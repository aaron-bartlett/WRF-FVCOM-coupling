&share
 wrf_core = 'ARW',
 max_dom = 2,
 start_date = '2015-07-11_12:00:00','2015-07-11_12:00:00',
 end_date   = '2015-07-12_12:00:00','2015-07-12_12:00:00',
 interval_seconds = 10800,
 io_form_geogrid = 2,
 debug_level = 0,
/

&geogrid
 parent_id         =   1,   1,
 parent_grid_ratio =   1,   3,
 i_parent_start    =   1,  95,
 j_parent_start    =   1,  38,
 s_we              =   1,   1,
 e_we              = 301, 430,
 s_sn              =   1,   1,
 e_sn              = 241, 412,
 geog_data_res     = 'modis_30s+30s', 'modis_30s+30s',
 dx        = 9000, 
 dy        = 9000, 
 map_proj  = 'lambert',
 map_proj = 'lambert',
 ref_lat   =  45.0,
 ref_lon   = -83.0,
 truelat1  =  60.0,
 truelat2  =  30.0,
 stand_lon = -83.0,
 geog_data_path = '/discover/nobackup/projects/nu-wrf/cases/geog'
/

&ungrib
 out_format = 'WPS',
 prefix     = 'NARR',
/

&metgrid
 fg_name         = 'NARR',
 io_form_metgrid = 2, 
/
