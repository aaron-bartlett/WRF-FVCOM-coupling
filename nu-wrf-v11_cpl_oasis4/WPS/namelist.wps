&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '1997-01-01_09:00:00',
 end_date   = '1997-02-01_09:00:00',
 interval_seconds = 10800,
 io_form_geogrid=2,
/

&geogrid
 parent_id         =   1,
 parent_grid_ratio =   1,
 i_parent_start    =   1,
 j_parent_start    =   1,
 e_we              =  544,
 e_sn              =  485,
 geog_data_res = 'default',
 dx = 4000,
 dy = 4000,
 map_proj = 'lambert',
 ref_lat   =  45.50,
 ref_lon   = -85.00,
 truelat1  =  30.0,
 truelat2  =  60.0,
 stand_lon = -85.0,
 opt_geogrid_tbl_path = './geogrid/'
 geog_data_path = './WPS_GEOG/'
/

&ungrib
 out_format = 'WPS',
 prefix = 'ERA5-SURF',
/

&metgrid
 fg_name = 'ERA5-SURF', 'ERA5-PRES',
 io_form_metgrid=2,
 opt_metgrid_tbl_path='./metgrid/',
/
